{
  "name": "office-assistance",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @office/web",
    "dev": "npm run build -w @office/types && concurrently -n api,web -c blue,green \"npm run dev -w @office/api\" \"npm run dev -w @office/web\"",
    "build": "npm run build -w @office/types && npm run prisma:generate -w @office/api && npm run build -w @office/api && npm run build -w @office/web",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -w @office/api",
    "test:speech": "cd services/speech && python -m pytest -q",
    "test:voice-ui": "tsx --test apps/web/src/features/voice/state/machine.test.ts",
    "test:forge-worker": "node --import tsx --test apps/forge-worker/src/buildRecipe.test.ts",
    "db:migrate": "npm run prisma:migrate -w @office/api",
    "db:generate": "npm run prisma:generate -w @office/api",
    "db:seed": "npm run db:seed -w @office/api",
    "forge:worker": "tsx apps/forge-worker/src/worker.ts",
    "docker:up": "docker compose up --build -d",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.61.1"
  },
  "engines": {
    "node": ">=20"
  }
}
