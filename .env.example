# =============================================================================
# Helm (dev-office-assistance) — local development template
# Copy to .env and fill values. Never commit real secrets.
# Full reference: docs/configuration.md
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=4000
APP_PUBLIC_URL=http://localhost:5174
RATE_LIMIT_MAX=200

# --- Networking ---
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080
# ALLOW_LOCALHOST_CORS_IN_PRODUCTION=false

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/office_assistance

# --- Authentication ---
# Required: at least 32 random characters (HS256 signing)
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional seed passwords (defaults in seed.ts if unset)
# SEED_LEAD_PASSWORD=
# SEED_ASSISTANT_PASSWORD=
# SEED_FORGE_MOBILE_LEAD_PASSWORD=
# SEED_FORGE_ADMIN_PASSWORD=   # legacy alias for mobile-lead password
# SEED_DEV_PASSWORD=
# SEED_DEMO_DATA=false

# --- Cache ---
# (none — schedulers run in-process)

# --- External Services ---
# M365_TENANT_ID=
# M365_CLIENT_ID=
# GITLAB_CONNECTION_NAME=gitlab-internal
# GITLAB_BASE_URL=http://10.10.20.51
# GITLAB_API_URL=
# GITLAB_ACCESS_TOKEN=
# GITLAB_WEBHOOK_SECRET=
# GITLAB_TLS_CA_FILE=
# GITHUB_CONNECTION_NAME=github-cloud
# GITHUB_API_URL=https://api.github.com
# GITHUB_BASE_URL=https://github.com
# GITHUB_ACCESS_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# CATALOG_SYNC_ENABLED=true
# CATALOG_SYNC_INTERVAL_MINUTES=30
# CATALOG_REQUEST_TIMEOUT_MS=10000
# Encrypts catalog + ClickUp PATs at rest (ClickUp falls back to this key).
# Local default is fine for development; use a strong random secret in production.
CATALOG_TOKEN_ENCRYPTION_KEY=local-dev-catalog-token-encryption-key
# CLICKUP_API_BASE_URL=https://api.clickup.com/api/v2
# CLICKUP_TOKEN_ENCRYPTION_KEY=
# CLICKUP_ACCESS_TOKEN=
# CLICKUP_SYNC_ENABLED=true
# CLICKUP_SYNC_INTERVAL_MINUTES=15
# CLICKUP_MAX_PAGES_PER_SYNC=20
# CLICKUP_SYNC_COMMENTS=true
# CLICKUP_WEBHOOK_BASE_URL=
# CLICKUP_TLS_INSECURE=false
# MICROSOFT_TODO_SYNC_ENABLED=true
# MICROSOFT_TODO_SYNC_INTERVAL_MINUTES=30
# CRON_SECRET=

# --- Workspace AI (assist + background insights) ---
# HELM_SECRET_ENCRYPTION_KEY=   # 32-byte base64 or 64-char hex; falls back to CATALOG_TOKEN_ENCRYPTION_KEY
# HELM_LLM_MOCK=                # set 1 for CI mock provider
# HELM_LLM_DAILY_CAP=200
# INSIGHTS_SCHEDULER_ENABLED=true
# INSIGHTS_SCHEDULER_INTERVAL_HOURS=24
# Optional: seed OpenRouter into DB at startup (never commit real keys)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Object Storage / files ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=26214400
FORGE_ARTIFACTS_ROOT=data/forge-artifacts
FORGE_WORKSPACES_ROOT=data/forge-workspaces
FORGE_MAX_ARTIFACT_BYTES=209715200
# FORGE_RUNNER_TOKEN_PEPPER=
FORGE_ALLOW_IOS_SIMULATION=false

# --- Email ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Observability ---
# (structured logs via Fastify; correlation via x-request-id)

# --- Feature Flags ---
# (integration toggles above)

# --- Streaming Voice Assistant (Parakeet STT + workspace LLM) ---
# Enable/model/API key: Apps → Workspace AI (same key as assist). Docs: docs/ai/voice-assistant-*.md
# VOICE_ASSISTANT_KILL_SWITCH=false
# SPEECH_PROVIDER=fake
# SPEECH_ENGINE=fake
# PARAKEET_MODEL=nvidia/parakeet-unified-en-0.6b
# SPEECH_SERVICE_URL=http://localhost:8000
# SPEECH_SERVICE_TOKEN=
# VOICE_SILENCE_FINALIZE_MS=1200
# VOICE_MAX_UTTERANCE_MS=120000
# AI_REASONING_PROVIDER=workspace
# AI_MAX_OUTPUT_TOKENS=2048
# AI_REQUEST_TIMEOUT_MS=60000
# AI_DAILY_BUDGET_USD=5
# Local fake speech (no Python/GPU): node services/speech/fake_server.mjs
# Opt-in live suites (never enable in CI):
# RUN_PARAKEET_LIVE_TESTS=false
# RUN_OPENROUTER_LIVE_TESTS=false

# --- Docker Registry ---
# NPM_STRICT_SSL=1
# Used by CI / LAN deploy (not read by API process):
# REGISTRY_NAMESPACE=anstwechy
# IMAGE_TAG=latest

# --- Deployment ---
# VITE_API_BASE_URL=http://localhost:4000
