generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

/// Microsoft Entra app (SPA) IDs for MSAL: optional until set in the UI or via server env.

model M365AppSettings {
  id String @id @default("default")

  tenantId String?

  clientId String?

  updatedAt DateTime @updatedAt
}

enum TriageCategory {
  blocker

  risk

  quality

  process

  other
}

enum TriageStatus {
  inbox

  in_progress

  snoozed

  done

  dropped
}

enum SourceType {
  outlook

  manual

  microsoft_todo

  clickup
}

/// People who can sign in (you + assistance). Roster for triage/teams is `Developer`.

model User {
  id String @id @default(uuid())

  email String @unique

  passwordHash String

  displayName String?

  role String @default("member")

  /// Future: email when assigned triage (requires SMTP or Graph mail).
  notifyEmailTriage Boolean @default(false) @map("notify_email_triage")

  /// Future: weekly digest email (not wired in v1).
  notifyEmailDigest Boolean @default(false) @map("notify_email_digest")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  createdItems TriageItem[] @relation("CreatedBy")

  attachments TriageAttachment[]

  expenses Expense[]

  planningItems PlanningItem[]

  standupCheckIns StandupCheckIn[]

  authoredDecisions TeamDecision[]

  forgeBuildRequests ForgeBuildRequest[]

  catalogTeamAssignments     CatalogTeamAssignment[]
  signalOverrides            SignalOverride[]
  repositoryOriginMigrations RepositoryOriginHistory[]
  importJobs                 RepositoryImportJob[]
  auditEvents                AuditEvent[]
  clickUpConnectionsCreated  ClickUpConnection[]     @relation("ClickUpConnectionCreatedBy")
  clickUpConnectionsUpdated  ClickUpConnection[]     @relation("ClickUpConnectionUpdatedBy")
  aiActionProposalsCreated   AiActionProposal[]      @relation("AiActionProposalCreatedBy")
  aiActionProposalsReviewed  AiActionProposal[]      @relation("AiActionProposalReviewedBy")
  llmWorkspaceSettingsUpdated LlmWorkspaceSettings[]
}

/// Roster entry: no login. Grouped in teams on Team management; assignable in triage.

model Developer {
  id String @id @default(uuid())

  displayName String

  skills String? @db.Text

  workEmail    String? @unique @map("work_email") @db.VarChar(320)
  phone        String? @map("phone") @db.VarChar(64)
  location     String? @map("location") @db.VarChar(200)
  bio          String? @map("bio") @db.Text
  skillDetails String? @map("skill_details") @db.Text
  achievements String? @map("achievements") @db.Text

  /// HR title from org sheet (e.g. Back-End Manager, Front-End (Web)).
  jobTitle String? @map("job_title") @db.VarChar(200)

  hireDate DateTime? @map("hire_date") @db.Date

  /// As on HR sheet, e.g. "7 years, 0 months" (optional; hireDate is source of truth when set).
  tenureLabel String? @map("tenure_label") @db.VarChar(120)

  rosterPosition RosterPosition @default(member) @map("roster_position")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  teamMemberships TeamMembership[]

  assignedTriage TriageItem[] @relation("TriageAssignee")

  catalogTeamAssignments CatalogTeamAssignment[]
  ownedRepositories      Repository[]            @relation("RepoTechnicalOwner")
  clickUpUserMappings    ClickUpUserMapping[]
}

model TriageItem {
  id String @id @default(uuid())

  title String

  description String?

  category TriageCategory

  status TriageStatus @default(inbox)

  nextAction String?

  dueAt DateTime?

  snoozedUntil DateTime?

  assigneeDeveloperId String

  assignee Developer @relation("TriageAssignee", fields: [assigneeDeveloperId], references: [id])

  sourceType SourceType @default(manual)

  graphMessageId String? @unique

  graphWebLink String?

  sourcePreview String?

  /// Microsoft To Do list id (Graph). Set by /api/todo/import; pairs with graphTodoTaskId.
  graphTodoListId String?

  /// Microsoft To Do task id. Unique together with graphTodoListId for upsert.
  graphTodoTaskId String?

  lastTodoSyncedAt DateTime?

  /// Bank program or client (optional tag for reporting).
  program String? @db.VarChar(200)

  /// Mark as leadership-visible escalation (priority queue).
  escalated Boolean @default(false)

  createdById String

  createdBy User @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  attachments TriageAttachment[]

  planningLinks PlanningTriageItem[]

  teamDecisions TeamDecision[] @relation("DecisionTriage")

  engineeringGaps    EngineeringGap[]
  externalWorkItems  ExternalWorkItem[]

  @@unique([graphTodoListId, graphTodoTaskId])
  @@index([status, dueAt])
  @@index([assigneeDeveloperId])
  @@index([category])
  @@index([program])
}

/// Files linked to a triage item (audio, PDF, images, etc.)

model TriageAttachment {
  id String @id @default(uuid())

  triageItemId String

  triageItem TriageItem @relation(fields: [triageItemId], references: [id], onDelete: Cascade)

  originalName String

  mimeType String

  sizeBytes Int

  storageKey String @unique

  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([triageItemId])
}

/// Department-level spend tracking (receipts optional).

model Expense {
  id String @id @default(uuid())

  title String

  description String?

  amount Decimal @db.Decimal(12, 2)

  currency String @default("USD")

  department String

  category String

  expenseDate DateTime

  receiptKey String?

  receiptName String?

  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([expenseDate])
}

enum PlanningStatus {
  draft

  active

  done

  cancelled
}

/// Director vs assistant (org chart); all others are `member` with optional per-team lead role.

enum RosterPosition {
  member

  department_head

  department_assistant
}

/// Engineering teams for roster / team management.

enum DevTeam {
  backend

  qa

  frontend_web

  frontend_mobile
}

/// Roadmap / planning items (initiatives, milestones) per dev area.

model PlanningItem {
  id String @id @default(uuid())

  title String

  description String?

  department String?

  targetDate DateTime?

  /// Bank program or client (optional tag).
  program String? @db.VarChar(200)

  status PlanningStatus @default(draft)

  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  triageLinks PlanningTriageItem[]

  teamDecisions TeamDecision[] @relation("DecisionPlanning")

  engineeringGaps EngineeringGap[]

  @@index([status])
  @@index([targetDate])
}

/// Developer membership in a dev team (one row per person per team).

model TeamMembership {
  id String @id @default(uuid())

  developerId String

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  team DevTeam

  /// That team’s manager/leader in the org sheet.
  isTeamLead Boolean @default(false) @map("is_team_lead")

  createdAt DateTime @default(now())

  @@unique([developerId, team])
  @@index([team])
  @@index([developerId])
}

/// Many-to-many: initiative ↔ related triage work items.
model PlanningTriageItem {
  planningItemId String

  triageItemId String

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)

  triageItem TriageItem @relation(fields: [triageItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([planningItemId, triageItemId])
  @@index([triageItemId])
}

/// Cadence: what shipped last period, what is next, blockers (two signed-in users).
model StandupCheckIn {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Monday (UTC) of the week; one row per user per week.
  weekStart DateTime @db.Date

  priorWork String @default("") @db.Text

  nextWork String @default("") @db.Text

  blockers String @default("") @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
}

/// Lightweight decision log (ADRs) with optional triage or planning links.
model TeamDecision {
  id String @id @default(uuid())

  title String @db.VarChar(500)

  body String @db.Text

  decidedOn DateTime @db.Date

  createdById String

  createdBy User @relation(fields: [createdById], references: [id])

  relatedTriageItemId String?

  relatedTriageItem TriageItem? @relation("DecisionTriage", fields: [relatedTriageItemId], references: [id], onDelete: SetNull)

  relatedPlanningItemId String?

  relatedPlanningItem PlanningItem? @relation("DecisionPlanning", fields: [relatedPlanningItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([decidedOn])
  @@index([createdById])
}

// ── Forge module (Flutter mobile build portal) ───────────────────────────────

enum ForgePlatform {
  Android
  iOS
}

enum ForgeBuildStatus {
  Draft
  Queued
  WaitingForCompatibleRunner
  Claimed
  PreparingWorkspace
  CloningRepository
  Building
  Signing
  CollectingArtifact
  UploadingArtifact
  Succeeded
  Failed
  Cancelled
  TimedOut
  PartiallySucceeded
  InProgress
  SimulationCompleted
}

enum ForgeRunnerStatus {
  Online
  Offline
  Draining
}

enum ForgeOperatingSystem {
  Windows
  macOS
  Linux
}

model ForgeBank {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique
  isActive             Boolean               @default(true)
  /// UNC/mapped folder default for PM shared delivery (API host must write here).
  sharedDeliveryPath   String?               @map("shared_delivery_path")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  applications         ForgeApplication[]
  bankApplicationLinks BankApplicationLink[]
}

model ForgeApplication {
  id                      String              @id @default(uuid())
  bankId                  String
  bank                    ForgeBank           @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name                    String
  description             String?
  repositoryProvider      String
  repositoryUrl           String
  repositoryCredentialRef String?
  /**
   * Monorepo Flutter root relative to repo clone (e.g. mobile/gateway_tester).
   */
  projectSubpath          String?
  defaultBranch           String              @default("main")
  requiredFlutterVersion  String?
  androidEnabled          Boolean             @default(true)
  iosEnabled              Boolean             @default(true)
  isActive                Boolean             @default(true)
  /// Optional override of bank.sharedDeliveryPath for this application.
  sharedDeliveryPath      String?             @map("shared_delivery_path")
  catalogApplicationId    String?             @map("catalog_application_id")
  catalogApplication      CatalogApplication? @relation(fields: [catalogApplicationId], references: [id], onDelete: SetNull)
  repositoryId            String?             @map("repository_id")
  repository              Repository?         @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  buildProfiles           ForgeBuildProfile[]
  buildRequests           ForgeBuildRequest[]

  @@index([bankId])
  @@index([catalogApplicationId])
  @@index([repositoryId])
}

model ForgeBuildProfile {
  id                  String              @id @default(uuid())
  applicationId       String
  application         ForgeApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  flutterFlavor       String?
  dartEntryPoint      String              @default("lib/main.dart")
  environmentName     String?
  androidArtifactType String              @default("apk")
  androidBuildMode    String              @default("release")
  iosExportMethod     String?
  timeoutMinutes      Int                 @default(60)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  buildRequests       ForgeBuildRequest[]

  @@index([applicationId])
}

model ForgeBuildRequest {
  id                      String               @id @default(uuid())
  applicationId           String
  application             ForgeApplication     @relation(fields: [applicationId], references: [id])
  buildProfileId          String
  buildProfile            ForgeBuildProfile    @relation(fields: [buildProfileId], references: [id])
  requestedById           String
  requestedBy             User                 @relation(fields: [requestedById], references: [id])
  gitReferenceType        String               @default("branch")
  gitReference            String
  resolvedCommitSha       String?
  requestNote             String?
  /// When true, copy successful artifacts to the bank/app shared folder and email PM + mobile leads.
  publishToSharedFolder   Boolean              @default(false) @map("publish_to_shared_folder")
  /// External PM email (no Helm login) — required when publishToSharedFolder is true.
  notifyEmail             String?              @map("notify_email")
  sharedDeliveryPath      String?              @map("shared_delivery_path")
  sharedDeliveryFileName  String?              @map("shared_delivery_file_name")
  /// pending | copied | failed | skipped
  sharedDeliveryStatus    String?              @map("shared_delivery_status")
  sharedDeliveryError     String?              @map("shared_delivery_error") @db.Text
  overallStatus           ForgeBuildStatus     @default(Queued)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  startedAtUtc            DateTime?
  completedAtUtc          DateTime?
  platformBuilds          ForgePlatformBuild[]

  @@index([applicationId])
  @@index([requestedById])
  @@index([overallStatus])
}

model ForgePlatformBuild {
  id              String            @id @default(uuid())
  buildRequestId  String
  buildRequest    ForgeBuildRequest @relation(fields: [buildRequestId], references: [id], onDelete: Cascade)
  platform        ForgePlatform
  status          ForgeBuildStatus  @default(Queued)
  runnerId        String?
  runner          ForgeRunner?      @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  attemptNumber   Int               @default(1)
  simulationOnly  Boolean           @default(false)
  queuedAtUtc     DateTime          @default(now())
  startedAtUtc    DateTime?
  completedAtUtc  DateTime?
  failureCategory String?
  failureSummary  String?
  artifacts       ForgeArtifact[]

  @@index([buildRequestId])
  @@index([status])
  @@index([runnerId])
}

model ForgeArtifact {
  id              String             @id @default(uuid())
  platformBuildId String
  platformBuild   ForgePlatformBuild @relation(fields: [platformBuildId], references: [id], onDelete: Cascade)
  fileName        String
  contentType     String
  fileSizeBytes   BigInt             @default(0)
  checksumSha256  String?
  storagePath     String
  createdAt       DateTime           @default(now())
  expiresAtUtc    DateTime?

  @@index([platformBuildId])
}

model ForgeRunner {
  id                    String               @id @default(uuid())
  name                  String               @unique
  operatingSystem       ForgeOperatingSystem
  architecture          String
  supportedPlatforms    ForgePlatform[]
  capabilities          Json
  status                ForgeRunnerStatus    @default(Offline)
  tokenHash             String?
  tokenHint             String?
  lastHeartbeatAtUtc    DateTime?
  maximumConcurrentJobs Int                  @default(1)
  currentJobCount       Int                  @default(0)
  version               String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  platformBuilds        ForgePlatformBuild[]
}

model ForgeAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ── Engineering Catalog ───────────────────────────────────────────────────────

enum RepositoryProviderKind {
  gitlab
  github
  azure_devops
  other
}

enum RepositoryLifecycleState {
  proposed
  preparing
  active
  maintenance
  deprecated
  archived
  unavailable
}

enum RepositoryConnectivityState {
  unknown
  reachable
  authentication_failed
  permission_denied
  not_found
  network_error
  tls_error
  provider_error
}

enum RepositoryFreshnessState {
  current
  stale
  never_synchronized
  partially_synchronized
  synchronization_failed
}

enum SignalState {
  unknown
  not_applicable
  declared
  detected
  passing
  failing
  stale
  inherited
  manually_overridden
  missing
  configured
}

enum BranchClassification {
  main
  development
  feature
  release
  hotfix
  bank_specific
  unknown
}

enum PipelineStatus {
  created
  waiting
  preparing
  pending
  running
  success
  failed
  canceled
  skipped
  manual
  scheduled
  blocked
  unknown
}

enum JobClassification {
  build
  unit_test
  integration_test
  end_to_end_test
  static_analysis
  lint
  security_scan
  dependency_scan
  secret_scan
  package
  deploy
  release
  unknown
}

enum ComponentDependencyKind {
  depends_on
  provides_api_to
  shared_core_for
  deployed_with
  replaces
  supersedes
  bank_variant_of
}

enum BackgroundJobStatus {
  pending
  leased
  running
  completed
  failed
  dead_letter
  cancelled
}

enum ImportJobStatus {
  uploaded
  parsing
  validating
  preview
  committing
  completed
  failed
  rolled_back
}

model CatalogTeam {
  id              String                  @id @default(uuid())
  slug            String                  @unique
  name            String
  description     String?                 @db.Text
  devTeamSlug     DevTeam?                @map("dev_team_slug")
  isActive        Boolean                 @default(true)
  archivedAt      DateTime?               @map("archived_at")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  systems         CatalogSystem[]
  assignments     CatalogTeamAssignment[]
  repositories    Repository[]
  engineeringGaps EngineeringGap[]
}

model CatalogTeamAssignment {
  id          String      @id @default(uuid())
  teamId      String      @map("team_id")
  team        CatalogTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String?     @map("user_id")
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  developerId String?     @map("developer_id")
  developer   Developer?  @relation(fields: [developerId], references: [id], onDelete: SetNull)
  role        String      @default("member")
  createdAt   DateTime    @default(now())

  @@index([teamId])
  @@index([userId])
  @@index([developerId])
}

model ApplicationType {
  id           String               @id @default(uuid())
  slug         String               @unique
  name         String
  description  String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  applications CatalogApplication[]
}

model CatalogSystem {
  id           String               @id @default(uuid())
  teamId       String               @map("team_id")
  team         CatalogTeam          @relation(fields: [teamId], references: [id])
  slug         String
  name         String
  description  String?              @db.Text
  archivedAt   DateTime?            @map("archived_at")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  applications CatalogApplication[]

  @@unique([teamId, slug])
  @@index([teamId])
}

model CatalogApplication {
  id                 String                   @id @default(uuid())
  systemId           String                   @map("system_id")
  system             CatalogSystem            @relation(fields: [systemId], references: [id])
  applicationTypeId  String?                  @map("application_type_id")
  applicationType    ApplicationType?         @relation(fields: [applicationTypeId], references: [id], onDelete: SetNull)
  slug               String
  name               String
  description        String?                  @db.Text
  archivedAt         DateTime?                @map("archived_at")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  components         Component[]
  forgeApplications  ForgeApplication[]
  bankLinks          BankApplicationLink[]
  sharedCoreAsSource SharedCoreRelationship[] @relation("SharedCoreSource")
  sharedCoreAsTarget SharedCoreRelationship[] @relation("SharedCoreTarget")
  environments       Environment[]

  @@unique([systemId, slug])
  @@index([systemId])
}

model ComponentType {
  id                String            @id @default(uuid())
  slug              String            @unique
  name              String
  description       String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  components        Component[]
  scorecardPolicies ScorecardPolicy[]
}

model Component {
  id               String                @id @default(uuid())
  applicationId    String                @map("application_id")
  application      CatalogApplication    @relation(fields: [applicationId], references: [id])
  componentTypeId  String?               @map("component_type_id")
  componentType    ComponentType?        @relation(fields: [componentTypeId], references: [id], onDelete: SetNull)
  slug             String
  name             String
  description      String?               @db.Text
  criticality      String?
  archivedAt       DateTime?             @map("archived_at")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  repository       Repository?
  dependenciesFrom ComponentDependency[] @relation("DepFrom")
  dependenciesTo   ComponentDependency[] @relation("DepTo")

  @@unique([applicationId, slug])
  @@index([applicationId])
}

model ComponentDependency {
  id              String                  @id @default(uuid())
  fromComponentId String                  @map("from_component_id")
  fromComponent   Component               @relation("DepFrom", fields: [fromComponentId], references: [id], onDelete: Cascade)
  toComponentId   String                  @map("to_component_id")
  toComponent     Component               @relation("DepTo", fields: [toComponentId], references: [id], onDelete: Cascade)
  kind            ComponentDependencyKind
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now())

  @@unique([fromComponentId, toComponentId, kind])
}

model RepositoryConnection {
  id                String                    @id @default(uuid())
  slug              String                    @unique
  name              String
  providerKind      RepositoryProviderKind    @map("provider_kind")
  baseUrl           String                    @map("base_url")
  apiUrl            String                    @map("api_url")
  encryptedToken    String?                   @map("encrypted_token") @db.Text
  tlsCaFile         String?                   @map("tls_ca_file")
  webhookSecret     String?                   @map("webhook_secret")
  syncEnabled       Boolean                   @default(true) @map("sync_enabled")
  isActive          Boolean                   @default(true) @map("is_active")
  lastVerifiedAt    DateTime?                 @map("last_verified_at")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  repositories      Repository[]
  originHistory     RepositoryOriginHistory[]
  syncRuns          SyncRun[]
  webhookDeliveries WebhookDelivery[]
}

model Repository {
  id                          String                      @id @default(uuid())
  connectionId                String                      @map("connection_id")
  connection                  RepositoryConnection        @relation(fields: [connectionId], references: [id])
  teamId                      String?                     @map("team_id")
  team                        CatalogTeam?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  componentId                 String?                     @unique @map("component_id")
  component                   Component?                  @relation(fields: [componentId], references: [id], onDelete: SetNull)
  name                        String
  canonicalUrl                String                      @map("canonical_url")
  normalizedProjectPath       String                      @map("normalized_project_path")
  providerProjectId           String?                     @map("provider_project_id")
  defaultBranch               String?                     @map("default_branch")
  reportedMainBranch          String?                     @map("reported_main_branch")
  reportedDevelopmentBranch   String?                     @map("reported_development_branch")
  reportedPipelineState       String?                     @map("reported_pipeline_state")
  reportedUnitTestState       SignalState?                @map("reported_unit_test_state")
  reportedStaticAnalysisState SignalState?                @map("reported_static_analysis_state")
  reportedSource              String?                     @map("reported_source")
  reportedAt                  DateTime?                   @map("reported_at")
  lifecycleState              RepositoryLifecycleState    @default(proposed) @map("lifecycle_state")
  connectivityState           RepositoryConnectivityState @default(unknown) @map("connectivity_state")
  freshnessState              RepositoryFreshnessState    @default(never_synchronized) @map("freshness_state")
  technicalOwnerId            String?                     @map("technical_owner_id")
  technicalOwner              Developer?                  @relation("RepoTechnicalOwner", fields: [technicalOwnerId], references: [id], onDelete: SetNull)
  businessOwnerNote           String?                     @map("business_owner_note") @db.Text
  criticality                 String?
  productionImpact            String?                     @map("production_impact")
  notes                       String?                     @db.Text
  archivedAt                  DateTime?                   @map("archived_at")
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  originHistory               RepositoryOriginHistory[]
  branches                    RepositoryBranch[]
  commits                     RepositoryCommitSnapshot[]
  mergeRequests               MergeRequestSnapshot[]
  pipelineRuns                PipelineRun[]
  checkResults                RepositoryCheckResult[]
  scorecardSnapshots          ScorecardSnapshot[]
  signalOverrides             SignalOverride[]
  forgeApplications           ForgeApplication[]
  syncRuns                    SyncRun[]
  importRows                  RepositoryImportRow[]
  deployments                 Deployment[]
  externalLinks               ExternalLink[]
  gaps                        EngineeringGap[]
  alerts                      CatalogAlert[]

  @@unique([connectionId, normalizedProjectPath])
  @@index([teamId])
  @@index([lifecycleState])
  @@index([freshnessState])
}

model RepositoryOriginHistory {
  id                    String                 @id @default(uuid())
  repositoryId          String                 @map("repository_id")
  repository            Repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  connectionId          String                 @map("connection_id")
  connection            RepositoryConnection   @relation(fields: [connectionId], references: [id])
  canonicalUrl          String                 @map("canonical_url")
