// --- External work items (Microsoft To Do + ClickUp) ---

enum ExternalProvider {
  microsoft_todo
  clickup
}

enum ExternalSyncState {
  idle
  syncing
  error
  stale
}

model ExternalWorkItem {
  id                 String            @id @default(uuid())
  provider           ExternalProvider
  /// ClickUpConnection.id or "m365" for Microsoft To Do
  connectionKey      String            @map("connection_key")
  workspaceId        String?           @map("workspace_id")
  spaceId            String?           @map("space_id")
  folderId           String?           @map("folder_id")
  listId             String?           @map("list_id")
  externalId         String            @map("external_id")
  externalParentId   String?           @map("external_parent_id")
  externalUrl        String?           @map("external_url") @db.Text
  title              String
  externalStatus     String?           @map("external_status")
  externalPriority   String?           @map("external_priority")
  externalUpdatedAt  DateTime?         @map("external_updated_at")
  lastSyncedAt       DateTime?         @map("last_synced_at")
  syncState          ExternalSyncState @default(idle) @map("sync_state")
  rawMetadata        Json?             @map("raw_metadata")
  triageItemId       String?           @map("triage_item_id")
  triageItem         TriageItem?       @relation(fields: [triageItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([provider, connectionKey, externalId])
  @@index([triageItemId])
  @@index([provider, listId])
  @@index([lastSyncedAt])
}

model ClickUpConnection {
  id                String   @id @default(uuid())
  name              String   @default("default")
  workspaceId       String?  @map("workspace_id")
  workspaceName     String?  @map("workspace_name")
  encryptedToken    String   @map("encrypted_token") @db.Text
  tokenHint         String?  @map("token_hint") @db.VarChar(16)
  autoSyncEnabled   Boolean  @default(true) @map("auto_sync_enabled")
  lastSyncAt        DateTime? @map("last_sync_at")
  lastSyncError     String?  @map("last_sync_error") @db.Text
  webhookId         String?  @map("webhook_id")
  webhookSecret     String?  @map("webhook_secret") @db.Text
  createdById       String?  @map("created_by_id")
  createdBy         User?    @relation("ClickUpConnectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?  @map("updated_by_id")
  updatedBy         User?    @relation("ClickUpConnectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listMappings      ClickUpListMapping[]
  statusMappings    ClickUpStatusMapping[]
  priorityMappings  ClickUpPriorityMapping[]
  userMappings      ClickUpUserMapping[]
  syncRuns          ExternalSyncRun[]
  webhookDeliveries ClickUpWebhookDelivery[]

  @@index([workspaceId])
}

model ClickUpListMapping {
  id                    String   @id @default(uuid())
  connectionId          String   @map("connection_id")
  connection            ClickUpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workspaceId           String   @map("workspace_id")
  spaceId               String   @map("space_id")
  spaceName             String?  @map("space_name")
  folderId              String?  @map("folder_id")
  folderName            String?  @map("folder_name")
  listId                String   @map("list_id")
  listName              String?  @map("list_name")
  enabled               Boolean  @default(true)
  importCategory        TriageCategory @default(other) @map("import_category")
  defaultAssigneeId     String?  @map("default_assignee_id")
  syncStatusToTriage    Boolean  @default(true) @map("sync_status_to_triage")
  syncDueToTriage       Boolean  @default(true) @map("sync_due_to_triage")
  lastSyncAt            DateTime? @map("last_sync_at")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([connectionId, listId])
  @@index([connectionId, enabled])
}

model ClickUpStatusMapping {
  id             String       @id @default(uuid())
  connectionId   String       @map("connection_id")
  connection     ClickUpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  clickUpStatus  String       @map("clickup_status")
  triageStatus   TriageStatus @map("triage_status")
  createdAt      DateTime     @default(now())

  @@unique([connectionId, clickUpStatus])
}

model ClickUpPriorityMapping {
  id               String   @id @default(uuid())
  connectionId     String   @map("connection_id")
  connection       ClickUpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  clickUpPriority  String   @map("clickup_priority")
  triageCategory   TriageCategory? @map("triage_category")
  escalated        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([connectionId, clickUpPriority])
}

model ClickUpUserMapping {
  id               String    @id @default(uuid())
  connectionId     String    @map("connection_id")
  connection       ClickUpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  clickUpUserId    String    @map("clickup_user_id")
  clickUpUsername  String?   @map("clickup_username")
  developerId      String    @map("developer_id")
  developer        Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@unique([connectionId, clickUpUserId])
  @@index([developerId])
}

model ExternalSyncRun {
  id             String   @id @default(uuid())
  provider       ExternalProvider
  connectionId   String?  @map("connection_id")
  connection     ClickUpConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  kind           String
  status         String   @default("running")
  startedAt      DateTime @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  itemsSeen      Int      @default(0) @map("items_seen")
  itemsUpserted  Int      @default(0) @map("items_upserted")
  itemsLinked    Int      @default(0) @map("items_linked")
  errorMessage   String?  @map("error_message") @db.Text
  errors         ExternalSyncError[]

  @@index([provider, startedAt])
  @@index([connectionId])
}

model ExternalSyncError {
  id        String          @id @default(uuid())
  syncRunId String          @map("sync_run_id")
  syncRun   ExternalSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  code      String
  message   String          @db.Text
  externalId String?        @map("external_id")
  createdAt DateTime        @default(now())

  @@index([syncRunId])
}

model ClickUpWebhookDelivery {
  id             String            @id @default(uuid())
  connectionId   String            @map("connection_id")
  connection     ClickUpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  deliveryId     String            @map("delivery_id")
  eventType      String            @map("event_type")
  status         String
  payload        Json?
  processedAt    DateTime?         @map("processed_at")
  idempotencyKey String            @unique @map("idempotency_key")
  createdAt      DateTime          @default(now())

  @@index([connectionId])
}

/// Settings for Microsoft To Do background sync (separate cron from ClickUp).
model MicrosoftTodoSyncSettings {
  id              String   @id @default("default")
  autoSyncEnabled Boolean  @default(false) @map("auto_sync_enabled")
  /// JSON array of Graph list ids to sync when a Graph token is available via job payload / env.
  connectedListIds Json     @default("[]") @map("connected_list_ids")
  lastSyncAt      DateTime? @map("last_sync_at")
  lastSyncError   String?  @map("last_sync_error") @db.Text
  updatedAt       DateTime @updatedAt
}
