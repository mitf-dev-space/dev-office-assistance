  lastTestedAt   DateTime? @map("last_tested_at")
  lastTestOk     Boolean?  @map("last_test_ok")
  updatedById    String?   @map("updated_by_id")
  updatedBy      User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
}

enum InsightSnapshotKind {
  weekly_ops
  catalog_health
  forge_builds
  morning_brief
  blocker_radar
}

enum InsightSnapshotStatus {
  pending
  ready
  failed
}

/// Durable metrics (+ optional LLM narrative) from background insight jobs.
model InsightSnapshot {
  id          String                @id @default(uuid())
  kind        InsightSnapshotKind
  periodStart DateTime              @map("period_start")
  periodEnd   DateTime              @map("period_end")
  metrics     Json
  narrative   Json?
  llmUsed     Boolean               @default(false) @map("llm_used")
  status      InsightSnapshotStatus @default(pending)
  error       String?               @db.Text
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([status, createdAt])
}

/// Staged AI write proposals — lead must approve before external/side effects.
model AiActionProposal {
  id           String    @id @default(uuid())
  kind         String
  status       String    @default("pending")
  title        String
  summary      String    @db.Text
  payload      Json
  result       Json?
  createdById  String?   @map("created_by_id")
  createdBy    User?     @relation("AiActionProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?   @map("reviewed_by_id")
  reviewedBy   User?     @relation("AiActionProposalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  reviewedAt   DateTime? @map("reviewed_at")

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@map("AiActionProposal")
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model EngineeringGap {
  id             String        @id @default(uuid())
  repositoryId   String        @map("repository_id")
  repository     Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  checkSlug      String        @map("check_slug")
  title          String
  priority       String        @default("medium")
  status         String        @default("open")
  ownerTeamId    String?       @map("owner_team_id")
  ownerTeam      CatalogTeam?  @relation(fields: [ownerTeamId], references: [id], onDelete: SetNull)
  triageItemId   String?       @map("triage_item_id")
  triageItem     TriageItem?   @relation(fields: [triageItemId], references: [id], onDelete: SetNull)
  planningItemId String?       @map("planning_item_id")
  planningItem   PlanningItem? @relation(fields: [planningItemId], references: [id], onDelete: SetNull)
  targetDate     DateTime?     @map("target_date")
  createdAt      DateTime      @default(now())
