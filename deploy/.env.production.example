# Copy to .env.production beside compose.production.yml on the server.
# Never commit real secrets.
# LAN host: 10.100.235.21 — web :46810, API :46811

# --- Application ---
NODE_ENV=production
PORT=4000
APP_PUBLIC_URL=http://10.100.235.21:46810
RATE_LIMIT_MAX=200

# --- Networking ---
CORS_ORIGIN=http://10.100.235.21:46810
ALLOW_LOCALHOST_CORS_IN_PRODUCTION=false
HELM_WEB_PORT=46810
HELM_API_PORT=46811

# --- Database ---
POSTGRES_USER=helm
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=office_assistance
DATABASE_URL=postgresql://helm:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/office_assistance

# --- Authentication ---
AUTH_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG

# --- Object Storage ---
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=26214400
FORGE_ARTIFACTS_ROOT=/app/data/forge-artifacts
FORGE_WORKSPACES_ROOT=/app/data/forge-workspaces
FORGE_MAX_ARTIFACT_BYTES=209715200
FORGE_ALLOW_IOS_SIMULATION=false
# FORGE_RUNNER_TOKEN_PEPPER=

# --- Feature Flags ---
CATALOG_SYNC_ENABLED=true
CLICKUP_SYNC_ENABLED=true
MICROSOFT_TODO_SYNC_ENABLED=true

# --- Docker Registry ---
REGISTRY_NAMESPACE=anstwechy
IMAGE_TAG=latest
PULL_POLICY=always

# --- Email (Forge build notifications + invites) ---
# Required for Helm-branded Forge success/failure emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Helm Forge <noreply@example.com>

# --- AI assist (optional; keys also configurable in UI) ---
# HELM_LLM_DAILY_CAP=200
# HELM_LLM_MOCK=

# --- External / catalog (optional) ---
# M365_TENANT_ID=
# M365_CLIENT_ID=
# GITLAB_BASE_URL=http://10.10.20.51
# GITLAB_ACCESS_TOKEN=
# GITHUB_ACCESS_TOKEN=
# CATALOG_TOKEN_ENCRYPTION_KEY=
# CLICKUP_TOKEN_ENCRYPTION_KEY=
# CLICKUP_ACCESS_TOKEN=
# CRON_SECRET=

# Web image must be built with:
#   VITE_API_BASE_URL=http://10.100.235.21:46811
